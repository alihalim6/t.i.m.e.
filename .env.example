# Database configuration (PostgreSQL via Docker on port 5433)
DATABASE_URL=postgresql+asyncpg://time_user:time_pass@localhost:5433/time_db

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
RESEND_API_KEY=your_resend_api_key_here

# App settings
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
